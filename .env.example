# Copy to .env (gitignored) or export these in your shell.
# JudgeKit reads plain environment variables; it does not load .env itself.
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Default cap (USD) for a BudgetTracker built without an explicit cap.
# `judgekit run` uses budget_usd from the eval YAML instead.
JUDGEKIT_ANTHROPIC_BUDGET_USD=
